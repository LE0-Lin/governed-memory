# Docker Compose development defaults. Python reads process environment, not this file.
POSTGRES_PASSWORD=local-memory-only
NEO4J_PASSWORD=local-graph-only
# Set these in the trusted server/operator process:
# MEMORY_DATABASE_URL=postgresql+psycopg://memory:local-memory-only@127.0.0.1:55432/memory
# MEMORY_NEO4J_URI=bolt://127.0.0.1:57687
# MEMORY_NEO4J_PASSWORD=local-graph-only
# MEMORY_TOKEN=<issued credential; never commit it>
